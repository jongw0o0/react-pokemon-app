/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

# 모든 JS/JSX/TS/TSX 파일은 LF 유지
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# CSS/HTML/JSON 등도 LF
*.css text eol=lf
*.html text eol=lf
